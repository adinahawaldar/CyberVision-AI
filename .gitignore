# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.js

# Environment & Secrets (Never commit credentials to public repo)
.env
.env*.local
.env.development
.env.test
.env.production
*.pem
*.key
*.cert

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/

# Large Model Weights (Auto-downloaded by Ultralytics YOLOv8 on first run)
*.pt
*.pth
*.onnx
*.engine
*.weights
*.bin

# User Uploads & Media Files (Privacy & Repository Size)
backend/data/uploads/*
!backend/data/uploads/.gitkeep
*.mp4
*.avi
*.mov
*.mkv
temp_*.mp4

# Next.js & Build Outputs
/.next/
/out/
/build/
/dist/

# Testing & Coverage
/coverage/
.pytest_cache/

# Debug Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor Preferences
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel
